rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'jordache.romania@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.email is string && data.email.size() <= 100 &&
             data.role in ['admin', 'farmer'] &&
             data.createdAt == request.time &&
             data.keys().hasAll(['email', 'role', 'createdAt', 'uid']) &&
             data.keys().size() <= 6;
    }

    function isValidProduct(data) {
      return data.farmerId == request.auth.uid &&
             data.farmName is string && data.farmName.size() >= 3 && data.farmName.size() <= 200 &&
             data.type is string && data.type.size() >= 2 && data.type.size() <= 100 &&
             data.quantity is number && data.quantity >= 0 && data.quantity <= 1000000 &&
             data.pricePerKg is number && data.pricePerKg >= 0 && data.pricePerKg <= 10000 &&
             data.createdAt == request.time &&
             data.keys().hasAll(['farmerId', 'farmName', 'type', 'quantity', 'pricePerKg', 'createdAt', 'paymentReceived']) &&
             data.keys().size() <= 15;
    }

    function isValidStore(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 200 &&
             data.type in ['carmangerie', 'lactate', 'mixt'] &&
             (!('cui' in data) || (data.cui is string && data.cui.size() <= 50)) &&
             (!('regCom' in data) || (data.regCom is string && data.regCom.size() <= 50)) &&
             data.keys().size() <= 20;
    }

    function isValidOrder(data) {
      return data.farmerId == request.auth.uid &&
             isValidId(data.storeId) &&
             data.orderNumber is string && data.orderNumber.size() >= 1 && data.orderNumber.size() <= 50 &&
             data.productName is string && data.productName.size() >= 2 && data.productName.size() <= 200 &&
             data.quantity is number && data.quantity >= 0 && data.quantity <= 1000000 &&
             data.pricePerKg is number && data.pricePerKg >= 0 && data.pricePerKg <= 10000 &&
             data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 10000000 &&
             data.createdAt == request.time &&
             data.keys().hasAll(['farmerId', 'storeId', 'orderNumber', 'productName', 'quantity', 'pricePerKg', 'totalAmount', 'createdAt', 'paid']) &&
             data.keys().size() <= 20;
    }

    function isValidPotentialPartner(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 200 &&
             data.type in ['carmangerie', 'lactate', 'mixt'] &&
             data.website is string && data.website.size() <= 500 &&
             data.city is string && data.city.size() <= 100 &&
             data.keys().size() <= 10;
    }

    function isValidMessage(data) {
      return data.senderId == request.auth.uid &&
             data.senderName is string && data.senderName.size() <= 100 &&
             data.senderRole in ['admin', 'farmer'] &&
             data.receiverId is string && data.receiverId.size() <= 128 &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 200 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 5000 &&
             data.createdAt == request.time &&
             data.read == false &&
             data.attachments is list && data.attachments.size() <= 5 &&
             data.keys().hasAll(['senderId', 'senderName', 'senderRole', 'receiverId', 'subject', 'body', 'read', 'createdAt', 'attachments']) &&
             data.keys().size() <= 12;
    }

    // --- Match Rules ---

    match /messages/{messageId} {
      allow get: if isSignedIn() && (isAdmin() || isOwner(existing().senderId) || isOwner(existing().receiverId));
      allow list: if isSignedIn() && (isAdmin() || resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isSignedIn() && isVerified() && isValidMessage(incoming()) && isValidId(messageId);
      allow update: if isSignedIn() && isVerified() && (
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['read'])) ||
        (isOwner(existing().receiverId) && incoming().diff(existing()).affectedKeys().hasOnly(['read']))
      );
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isVerified() && isValidUser(incoming()) && isValidId(userId);
      allow update: if isVerified() && (
        (isAdmin() && incoming().role == incoming().role) || 
        (isOwner(userId) && 
         incoming().role == existing().role && 
         incoming().email == existing().email && 
         incoming().uid == existing().uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'farmName']))
      );
    }

    match /products/{productId} {
      allow get: if isSignedIn() && (isAdmin() || (isOwner(existing().farmerId)));
      allow list: if isSignedIn() && (isAdmin() || (resource.data.farmerId == request.auth.uid));
      allow create: if isSignedIn() && isVerified() && isValidProduct(incoming()) && isValidId(productId);
      allow update: if isSignedIn() && isVerified() && (
        isAdmin() || (
          isOwner(existing().farmerId) && 
          incoming().farmerId == existing().farmerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['type', 'quantity', 'pricePerKg', 'deliveryFrequency', 'minOrderQuantity', 'packagingType', 'shelfLife', 'certification', 'deliveryTerms', 'paymentTerms', 'paymentReceived', 'partnerStoreId', 'farmName'])
        )
      );
      allow delete: if isAdmin() || (isSignedIn() && isOwner(existing().farmerId));
    }

    match /partnerStores/{storeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isVerified() && isValidStore(incoming()) && isValidId(storeId);
      allow update: if (isAdmin() || (isSignedIn() && isVerified())) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'type', 'website', 'cui', 'regCom', 'address', 'phone']);
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && (isAdmin() || isOwner(existing().farmerId));
      allow list: if isSignedIn() && (isAdmin() || resource.data.farmerId == request.auth.uid);
      allow create: if isSignedIn() && isVerified() && isValidOrder(incoming()) && isValidId(orderId);
      allow update: if isSignedIn() && isVerified() && (
        isAdmin() || (
          isOwner(existing().farmerId) &&
          incoming().farmerId == existing().farmerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['paid', 'observations'])
        )
      );
      allow delete: if isAdmin();
    }

    match /potentialPartners/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidPotentialPartner(incoming()) && isValidId(partnerId);
    }
  }
}
